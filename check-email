<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Check your email — Relay</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📡</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/splash.css">
<style>
  :root{
    --navy:#0E2A52; --navy-3:#1E4F94; --ink:#101828; --ink-soft:#5C6577;
    --bg:#F5F7FA; --card:#FFFFFF; --amber:#F5A623; --line:rgba(16,24,40,0.10);
  }
  *{box-sizing:border-box;}
  body{ margin:0; min-height:100vh; background:var(--bg); color:var(--ink);
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif; display:flex; flex-direction:column; }
  h1{ font-family:'Fredoka',sans-serif; font-weight:600; margin:0; letter-spacing:-0.01em; }
  a{ color:inherit; }

  .hero{ background:linear-gradient(160deg, var(--navy) 0%, var(--navy-3) 100%); color:#fff;
    padding:34px 24px 78px; position:relative; overflow:hidden; }
  .hero::after{ content:""; position:absolute; right:-60px; top:-60px; width:260px; height:260px;
    border-radius:44% 56% 60% 40% / 50% 45% 55% 50%; background:rgba(255,255,255,0.06); }
  .hero-top{ display:flex; align-items:center; justify-content:space-between; position:relative; z-index:1; max-width:420px; margin:0 auto; }
  .brand{ display:flex; align-items:center; gap:9px; font-family:'Fredoka',sans-serif; font-weight:600; font-size:1.12rem; text-decoration:none; color:#fff; }
  .brand-mark{ width:26px; height:26px; border-radius:38% 62% 60% 40% / 45% 40% 60% 55%; background:var(--amber); }
  .hero-top a.back{ font-size:0.9rem; color:rgba(255,255,255,0.75); text-decoration:none; }

  main{ flex-grow:1; padding:0 20px 60px; margin-top:-52px; position:relative; z-index:2; display:flex; }
  .card{ max-width:420px; margin:0 auto; background:var(--card); border-radius:24px; padding:40px 30px 34px;
    box-shadow:0 24px 48px -20px rgba(14,42,82,0.25); border:1px solid var(--line); text-align:center; }
  .icon{
    width:64px; height:64px; border-radius:50%; background:#FFF1DA; color:var(--amber);
    display:flex; align-items:center; justify-content:center; margin:0 auto 20px;
  }
  .card h1{ font-size:1.4rem; }
  .card p{ color:var(--ink-soft); font-size:0.98rem; margin-top:12px; line-height:1.55; }
  .email-chip{
    display:inline-block; margin-top:14px; padding:8px 16px; border-radius:100px;
    background:var(--bg); font-weight:600; font-size:0.9rem; color:var(--navy);
  }
  .steps{ text-align:left; margin:26px 0 0; padding:0; list-style:none; }
  .steps li{ display:flex; gap:10px; font-size:0.9rem; color:var(--ink-soft); padding:9px 0; border-top:1px solid var(--line); }
  .steps li:first-child{ border-top:none; }
  .steps b{ color:var(--ink); font-weight:600; }

  .btn{ display:flex; align-items:center; justify-content:center; gap:8px; width:100%; padding:14px 20px;
    border-radius:14px; border:1.5px solid var(--line); cursor:pointer; font-size:0.95rem; font-weight:700;
    font-family:'Inter',sans-serif; background:#fff; color:var(--navy); margin-top:26px;
    transition:border-color .2s ease, background .2s ease; }
  .btn:hover{ border-color:var(--navy-3); }
  .btn[disabled]{ opacity:.6; cursor:not-allowed; }

  .msg{ display:none; font-size:0.85rem; font-weight:500; margin-top:12px; }
  .msg.show{ display:block; }
  .msg-ok{ color:#0F6B3C; }
  .msg-err{ color:#B3261E; }
</style>
</head>
<body>

<header class="hero">
  <div class="hero-top">
    <a href="index.html" class="brand"><span class="brand-mark"></span>Relay</a>
    <a href="login.html" class="back">← Back to log in</a>
  </div>
</header>

<main>
  <div class="card">
    <div class="icon" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M3 6.5 12 13l9-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="2"/></svg>
    </div>
    <h1>Confirm your email</h1>
    <p>We've sent a confirmation link to</p>
    <span class="email-chip" id="email-chip">your email</span>

    <ul class="steps">
      <li><b>1.</b>&nbsp;Open the email and tap the confirmation link.</li>
      <li><b>2.</b>&nbsp;Don't see it? Check your spam or junk folder.</li>
      <li><b>3.</b>&nbsp;Found it there? Mark it "not spam" so future emails from us land straight in your inbox.</li>
    </ul>

    <button id="resend-btn" class="btn">Resend confirmation link</button>
    <div id="msg" class="msg"></div>
  </div>
</main>

<script type="module">
  import { auth, siteUrl } from "./assets/firebase-config.js";
  import { sendEmailVerification } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-auth.js";

  const params = new URLSearchParams(window.location.search);
  const email = params.get("email");
  if (email) document.getElementById("email-chip").textContent = email;

  const resendBtn = document.getElementById("resend-btn");
  const msg = document.getElementById("msg");

  resendBtn.addEventListener("click", async () => {
    if (!auth.currentUser) {
      msg.textContent = "Please log in again to resend the link.";
      msg.className = "msg show msg-err";
      return;
    }
    resendBtn.disabled = true;
    resendBtn.textContent = "Sending…";
    try {
      await sendEmailVerification(auth.currentUser, { url: siteUrl("verify-email.html") });
      msg.textContent = "Sent! Check your inbox (and spam) again.";
      msg.className = "msg show msg-ok";
    } catch (err) {
      msg.textContent = err.message.replace("Firebase: ", "");
      msg.className = "msg show msg-err";
    }
    resendBtn.disabled = false;
    resendBtn.textContent = "Resend confirmation link";
  });
</script>
<script type="module" src="./assets/splash.js"></script>

</body>
</html>
